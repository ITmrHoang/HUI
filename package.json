  "scripts": {
    "prebuild": "node scripts/sync-exports.mjs",
    "dev": "vite",
    "build": "vite build && cem analyze && node scripts/gen-types.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "build:cdn": "vite build --config vite.cdn.config.js",
    "build:examples": "vite build --config vite.examples.config.js",
    "check:types": "tsc -p tsconfig.types.json",
    "size": "node scripts/size-report.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm run build:cdn && changeset publish",
    "analyze": "cem analyze",
    "check:static": "node scripts/check-static-build.mjs"
  },
